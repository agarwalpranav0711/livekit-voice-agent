# Browser-access passphrase. Generate a random secret of at least 24 characters.
WEB_ACCESS_PASSWORD=

# The exact website origin allowed to call this API.
WEB_ORIGIN=http://localhost:5173

# Local development binds only to this computer.
API_HOST=127.0.0.1
API_PORT=3001

# Keep at 0 unless the API is reachable only through a known reverse proxy.
TRUST_PROXY_HOPS=0
